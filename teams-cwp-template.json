{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Defender for Cloud CWP alerts to Microsoft Teams",
    "description": "Deploys a Defender for Cloud alert workflow automation and a Logic App that posts Adaptive Cards to a Teams channel."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Deployment region for the Logic Apps, API connections, and workflow automations."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "mdc-teams",
      "minLength": 3,
      "maxLength": 40,
      "metadata": {
        "description": "Prefix used for deployed resource names."
      }
    },
    "teamId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Teams team ID (group ID) that contains the target channel."
      }
    },
    "channelId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Teams channel ID that receives Adaptive Cards."
      }
    },
    "alertSeverities": {
      "type": "array",
      "defaultValue": [
        "High",
        "Medium",
        "Low"
      ],
      "metadata": {
        "description": "Defender for Cloud alert severities to notify. Valid values are High, Medium, and Low."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "security-notification",
        "managedBy": "arm-template"
      },
      "metadata": {
        "description": "Tags applied to deployed resources."
      }
    }
  },
  "variables": {
    "alertWorkflowName": "[format('{0}-cwp-alert', parameters('namePrefix'))]",
    "alertConnectionName": "[format('{0}-ascalert', parameters('namePrefix'))]",
    "teamsConnectionName": "[format('{0}-teams', parameters('namePrefix'))]",
    "alertAutomationName": "[format('{0}-alert-automation', parameters('namePrefix'))]",
    "alertTriggerName": "When_a_Microsoft_Defender_for_Cloud_Alert_is_created_or_triggered"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('alertConnectionName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[variables('alertConnectionName')]",
        "customParameterValues": {},
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'ascalert')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('teamsConnectionName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[variables('teamsConnectionName')]",
        "customParameterValues": {},
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('alertWorkflowName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject('LogicAppsCategory', 'security'))]",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "teamId": {
              "type": "String"
            },
            "channelId": {
              "type": "String"
            },
            "subscriptionName": {
              "type": "String"
            }
          },
          "triggers": {
            "[format('{0}', variables('alertTriggerName'))]": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['ascalert']['connectionId']"
                  }
                },
                "path": "/Microsoft.Security/Alert/subscribe"
              }
            }
          },
          "actions": {
            "Compose_Alert_Details": {
              "type": "Compose",
              "inputs": {
                "alertName": "@{coalesce(triggerBody()?['AlertDisplayName'], '(名前なし)')}",
                "resourceName": "@{coalesce(triggerBody()?['CompromisedEntity'], triggerBody()?['ExtendedProperties']?['resourceName'], triggerBody()?['ExtendedProperties']?['EffectiveAzureResourceId'], '不明')}",
                "description": "@{coalesce(triggerBody()?['Description'], '説明はありません。')}",
                "subscriptionName": "@parameters('subscriptionName')",
                "severity": "@{coalesce(triggerBody()?['Severity'], '不明')}",
                "severityColor": "@{if(equals(toLower(coalesce(triggerBody()?['Severity'], '')), 'high'), 'Attention', if(equals(toLower(coalesce(triggerBody()?['Severity'], '')), 'medium'), 'Warning', 'Accent'))}",
                "severityIndicator": "@{if(equals(toLower(coalesce(triggerBody()?['Severity'], '')), 'high'), '🔴', if(equals(toLower(coalesce(triggerBody()?['Severity'], '')), 'medium'), '🟡', '🔵'))}",
                "detectedAt": "@{coalesce(triggerBody()?['StartTimeUtc'], triggerBody()?['TimeGenerated'], utcNow())}",
                "portalUrl": "@{coalesce(triggerBody()?['AlertUri'], 'https://portal.azure.com/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/7')}"
              },
              "runAfter": {}
            },
            "Compose_Adaptive_Card": {
              "type": "Compose",
              "inputs": {
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "msteams": {
                  "width": "Full"
                },
                "body": [
                  {
                    "type": "TextBlock",
                    "text": "Defender for Cloud セキュリティアラート",
                    "weight": "Bolder",
                    "size": "Medium",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "text": "@{outputs('Compose_Alert_Details')?['alertName']}",
                    "weight": "Bolder",
                    "size": "Large",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "text": "@{outputs('Compose_Alert_Details')?['description']}",
                    "wrap": true
                  },
                  {
                    "type": "FactSet",
                    "facts": [
                      {
                        "title": "重要度",
                        "value": "@{concat(outputs('Compose_Alert_Details')?['severityIndicator'], ' ', outputs('Compose_Alert_Details')?['severity'])}"
                      },
                      {
                        "title": "検知時刻 (UTC)",
                        "value": "@{outputs('Compose_Alert_Details')?['detectedAt']}"
                      },
                      {
                        "title": "対象リソース",
                        "value": "@{outputs('Compose_Alert_Details')?['resourceName']}"
                      },
                      {
                        "title": "サブスクリプション名",
                        "value": "@{outputs('Compose_Alert_Details')?['subscriptionName']}"
                      }
                    ]
                  },
                  {
                    "type": "TextBlock",
                    "text": "Microsoft Defender for Cloud | CWP",
                    "isSubtle": true,
                    "spacing": "Medium",
                    "wrap": true
                  }
                ],
                "actions": [
                  {
                    "type": "Action.OpenUrl",
                    "title": "Defender for Cloud で確認",
                    "url": "@{outputs('Compose_Alert_Details')?['portalUrl']}"
                  }
                ]
              },
              "runAfter": {
                "Compose_Alert_Details": [
                  "Succeeded"
                ]
              }
            },
            "Post_Alert_to_Teams": {
              "type": "ApiConnection",
              "inputs": {
                "body": {
                  "messageBody": "@{string(outputs('Compose_Adaptive_Card'))}",
                  "recipient": {
                    "groupId": "@parameters('teamId')",
                    "channelId": "@parameters('channelId')"
                  }
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['teams']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v1.0/teams/conversation/adaptivecard/poster/@{encodeURIComponent('User')}/location/@{encodeURIComponent('Channel')}"
              },
              "runAfter": {
                "Compose_Adaptive_Card": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "ascalert": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('alertConnectionName'))]",
                "connectionName": "[variables('alertConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'ascalert')]"
              },
              "teams": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('teamsConnectionName'))]",
                "connectionName": "[variables('teamsConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
              }
            }
          },
          "teamId": {
            "value": "[parameters('teamId')]"
          },
          "channelId": {
            "value": "[parameters('channelId')]"
          },
          "subscriptionName": {
            "value": "[subscription().displayName]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('alertConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('teamsConnectionName'))]"
      ]
    },
    {
      "type": "Microsoft.Security/automations",
      "apiVersion": "2023-12-01-preview",
      "name": "[variables('alertAutomationName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "Send Defender for Cloud workload protection alerts to Microsoft Teams.",
        "isEnabled": true,
        "scopes": [
          {
            "description": "[format('All resources in subscription {0}', subscription().subscriptionId)]",
            "scopePath": "[subscription().id]"
          }
        ],
        "sources": [
          {
            "copy": [
              {
                "name": "ruleSets",
                "count": "[length(parameters('alertSeverities'))]",
                "input": {
                  "rules": [
                    {
                      "propertyJPath": "Severity",
                      "propertyType": "String",
                      "expectedValue": "[parameters('alertSeverities')[copyIndex('ruleSets')]]",
                      "operator": "Equals"
                    }
                  ]
                }
              }
            ],
            "eventSource": "Alerts"
          }
        ],
        "actions": [
          {
            "actionType": "LogicApp",
            "logicAppResourceId": "[resourceId('Microsoft.Logic/workflows', variables('alertWorkflowName'))]",
            "uri": "[listCallbackUrl(format('{0}/triggers/{1}', resourceId('Microsoft.Logic/workflows', variables('alertWorkflowName')), variables('alertTriggerName')), '2016-06-01').value]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', variables('alertWorkflowName'))]"
      ]
    }
  ],
  "outputs": {
    "alertLogicAppName": {
      "type": "string",
      "value": "[variables('alertWorkflowName')]"
    },
    "teamsConnectionName": {
      "type": "string",
      "value": "[variables('teamsConnectionName')]"
    },
    "alertAutomationResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Security/automations', variables('alertAutomationName'))]"
    }
  }
}
