
{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Defender for Cloud CWP alerts to Slack by subscription",
    "description": "Deploys a Logic App that routes Defender for Cloud alert Block Kit messages to Slack by subscription. Defender for Cloud workflow automation must be configured separately."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Deployment region for the Logic App and API connection."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "mdc-slack-multi",
      "minLength": 3,
      "maxLength": 40,
      "metadata": {
        "description": "Prefix used for deployed resource names."
      }
    },
    "azureMgmtSubscriptionId": {
      "type": "string",
      "metadata": {
        "description": "Subscription ID for ME-MngEnvMCAP780637-AzureMgmt."
      }
    },
    "azureVnetSubscriptionId": {
      "type": "string",
      "metadata": {
        "description": "Subscription ID for ME-MngEnvMCAP780637-AzureVnet."
      }
    },
    "azureMgmtSlackWebhookUrl": {
      "type": "string",
      "metadata": {
        "description": "Slack Incoming Webhook URL for the ME-MngEnvMCAP780637-AzureMgmt CWP channel."
      }
    },
    "azureVnetSlackWebhookUrl": {
      "type": "string",
      "metadata": {
        "description": "Slack Incoming Webhook URL for the ME-MngEnvMCAP780637-AzureVnet CWP channel."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "security-notification",
        "managedBy": "arm-template"
      },
      "metadata": {
        "description": "Tags applied to deployed resources."
      }
    }
  },
  "variables": {
    "alertWorkflowName": "[format('{0}-cwp-alert', parameters('namePrefix'))]",
    "alertConnectionName": "[format('{0}-ascalert', parameters('namePrefix'))]",
    "alertTriggerName": "When_a_Microsoft_Defender_for_Cloud_Alert_is_created_or_triggered"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('alertConnectionName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[variables('alertConnectionName')]",
        "customParameterValues": {},
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'ascalert')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('alertWorkflowName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject('LogicAppsCategory', 'security'))]",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "azureMgmtSlackWebhookUrl": {
              "type": "String"
            },
            "azureVnetSlackWebhookUrl": {
              "type": "String"
            },
            "azureMgmtSubscriptionId": {
              "type": "String"
            },
            "azureVnetSubscriptionId": {
              "type": "String"
            }
          },
          "triggers": {
            "[format('{0}', variables('alertTriggerName'))]": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['ascalert']['connectionId']"
                  }
                },
                "path": "/Microsoft.Security/Alert/subscribe"
              }
            }
          },
          "actions": {
            "Compose_Alert_Details": {
              "type": "Compose",
              "inputs": {
                "alertName": "@{coalesce(triggerBody()?['AlertDisplayName'], '(名前なし)')}",
                "resourceName": "@{coalesce(triggerBody()?['CompromisedEntity'], triggerBody()?['ExtendedProperties']?['resourceName'], triggerBody()?['ExtendedProperties']?['EffectiveAzureResourceId'], '不明')}",
                "description": "@{coalesce(triggerBody()?['Description'], '説明はありません。')}",
                "sourceSubscriptionId": "@{toLower(if(empty(triggerBody()?['AzureResourceSubscriptionId']), coalesce(triggerBody()?['WorkspaceSubscriptionId'], 'unknown'), triggerBody()?['AzureResourceSubscriptionId']))}",
                "subscriptionName": "@{if(equals(toLower(if(empty(triggerBody()?['AzureResourceSubscriptionId']), coalesce(triggerBody()?['WorkspaceSubscriptionId'], ''), triggerBody()?['AzureResourceSubscriptionId'])), toLower(parameters('azureMgmtSubscriptionId'))), 'ME-MngEnvMCAP780637-AzureMgmt', if(equals(toLower(if(empty(triggerBody()?['AzureResourceSubscriptionId']), coalesce(triggerBody()?['WorkspaceSubscriptionId'], ''), triggerBody()?['AzureResourceSubscriptionId'])), toLower(parameters('azureVnetSubscriptionId'))), 'ME-MngEnvMCAP780637-AzureVnet', coalesce(triggerBody()?['AzureResourceSubscriptionId'], triggerBody()?['WorkspaceSubscriptionId'], '不明')))}",
                "severity": "@{coalesce(triggerBody()?['Severity'], '不明')}",
                "severityColor": "@{if(equals(toLower(coalesce(triggerBody()?['Severity'], '')), 'high'), '#E01E5A', if(equals(toLower(coalesce(triggerBody()?['Severity'], '')), 'medium'), '#ECB22E', '#36C5F0'))}",
                "severityIndicator": "@{if(equals(toLower(coalesce(triggerBody()?['Severity'], '')), 'high'), '🔴', if(equals(toLower(coalesce(triggerBody()?['Severity'], '')), 'medium'), '🟡', '🔵'))}",
                "detectedAt": "@{coalesce(triggerBody()?['StartTimeUtc'], triggerBody()?['TimeGenerated'], utcNow())}",
                "portalUrl": "@{coalesce(triggerBody()?['AlertUri'], 'https://portal.azure.com/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/7')}"
              },
              "runAfter": {}
            },
            "Compose_Slack_Message": {
              "type": "Compose",
              "inputs": {
                "text": "@{concat('[Defender for Cloud] ', outputs('Compose_Alert_Details')?['severity'], ' alert: ', outputs('Compose_Alert_Details')?['alertName'])}",
                "attachments": [
                  {
                    "color": "@{outputs('Compose_Alert_Details')?['severityColor']}",
                    "blocks": [
                      {
                        "type": "header",
                        "text": {
                          "type": "plain_text",
                          "text": "Defender for Cloud セキュリティアラート",
                          "emoji": true
                        }
                      },
                      {
                        "type": "section",
                        "text": {
                          "type": "mrkdwn",
                          "text": "@{concat('*', outputs('Compose_Alert_Details')?['alertName'], '*\n', outputs('Compose_Alert_Details')?['description'])}"
                        }
                      },
                      {
                        "type": "section",
                        "fields": [
                          {
                            "type": "mrkdwn",
                            "text": "@{concat('*重要度*\n', outputs('Compose_Alert_Details')?['severityIndicator'], ' ', outputs('Compose_Alert_Details')?['severity'])}"
                          },
                          {
                            "type": "mrkdwn",
                            "text": "@{concat('*検知時刻 (UTC)*\n', outputs('Compose_Alert_Details')?['detectedAt'])}"
                          },
                          {
                            "type": "mrkdwn",
                            "text": "@{concat('*対象リソース*\n', outputs('Compose_Alert_Details')?['resourceName'])}"
                          },
                          {
                            "type": "mrkdwn",
                            "text": "@{concat('*サブスクリプション名*\n', outputs('Compose_Alert_Details')?['subscriptionName'])}"
                          }
                        ]
                      },
                      {
                        "type": "actions",
                        "elements": [
                          {
                            "type": "button",
                            "text": {
                              "type": "plain_text",
                              "text": "Defender for Cloud で確認"
                            },
                            "style": "primary",
                            "url": "@{outputs('Compose_Alert_Details')?['portalUrl']}"
                          }
                        ]
                      },
                      {
                        "type": "context",
                        "elements": [
                          {
                            "type": "mrkdwn",
                            "text": "Microsoft Defender for Cloud | CWP"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "runAfter": {
                "Compose_Alert_Details": [
                  "Succeeded"
                ]
              }
            },
            "Route_Alert_By_Subscription": {
              "type": "Switch",
              "expression": "@if(equals(outputs('Compose_Alert_Details')?['sourceSubscriptionId'], toLower(parameters('azureMgmtSubscriptionId'))), 'AzureMgmt', if(equals(outputs('Compose_Alert_Details')?['sourceSubscriptionId'], toLower(parameters('azureVnetSubscriptionId'))), 'AzureVnet', 'Unknown'))",
              "cases": {
                "AzureMgmt": {
                  "case": "AzureMgmt",
                  "actions": {
                    "Post_Alert_to_AzureMgmt_Slack": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "@parameters('azureMgmtSlackWebhookUrl')",
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": "@outputs('Compose_Slack_Message')"
                      }
                    }
                  }
                },
                "AzureVnet": {
                  "case": "AzureVnet",
                  "actions": {
                    "Post_Alert_to_AzureVnet_Slack": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "@parameters('azureVnetSlackWebhookUrl')",
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": "@outputs('Compose_Slack_Message')"
                      }
                    }
                  }
                }
              },
              "default": {
                "actions": {}
              },
              "runAfter": {
                "Compose_Slack_Message": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "ascalert": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('alertConnectionName'))]",
                "connectionName": "[variables('alertConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'ascalert')]"
              }
            }
          },
          "azureMgmtSlackWebhookUrl": {
            "value": "[parameters('azureMgmtSlackWebhookUrl')]"
          },
          "azureVnetSlackWebhookUrl": {
            "value": "[parameters('azureVnetSlackWebhookUrl')]"
          },
          "azureMgmtSubscriptionId": {
            "value": "[parameters('azureMgmtSubscriptionId')]"
          },
          "azureVnetSubscriptionId": {
            "value": "[parameters('azureVnetSubscriptionId')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('alertConnectionName'))]"
      ]
    }
  ],
  "outputs": {
    "alertLogicAppName": {
      "type": "string",
      "value": "[variables('alertWorkflowName')]"
    }
  }
}
