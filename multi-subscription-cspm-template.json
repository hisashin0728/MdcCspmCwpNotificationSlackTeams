{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Defender for Cloud CSPM recommendations to Slack by subscription",
    "description": "Deploys a Logic App that routes Defender for Cloud recommendation Block Kit messages to Slack by subscription. Defender for Cloud workflow automation must be configured separately."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Deployment region for the Logic App and API connection."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "mdc-slack-multi",
      "minLength": 3,
      "maxLength": 40,
      "metadata": {
        "description": "Prefix used for deployed resource names."
      }
    },
    "azureMgmtSubscriptionId": {
      "type": "string",
      "metadata": {
        "description": "Subscription ID for ME-MngEnvMCAP780637-AzureMgmt."
      }
    },
    "azureVnetSubscriptionId": {
      "type": "string",
      "metadata": {
        "description": "Subscription ID for ME-MngEnvMCAP780637-AzureVnet."
      }
    },
    "azureMgmtSlackWebhookUrl": {
      "type": "string",
      "metadata": {
        "description": "Slack Incoming Webhook URL for the ME-MngEnvMCAP780637-AzureMgmt CSPM channel."
      }
    },
    "azureVnetSlackWebhookUrl": {
      "type": "string",
      "metadata": {
        "description": "Slack Incoming Webhook URL for the ME-MngEnvMCAP780637-AzureVnet CSPM channel."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "security-notification",
        "managedBy": "arm-template"
      },
      "metadata": {
        "description": "Tags applied to deployed resources."
      }
    }
  },
  "variables": {
    "recommendationWorkflowName": "[format('{0}-cspm-recommendation', parameters('namePrefix'))]",
    "recommendationConnectionName": "[format('{0}-ascassessment', parameters('namePrefix'))]",
    "recommendationTriggerName": "When_a_Microsoft_Defender_for_Cloud_recommendation_is_created_or_triggered"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('recommendationConnectionName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[variables('recommendationConnectionName')]",
        "customParameterValues": {},
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'ascassessment')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('recommendationWorkflowName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject('LogicAppsCategory', 'security'))]",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "azureMgmtSlackWebhookUrl": {
              "type": "String"
            },
            "azureVnetSlackWebhookUrl": {
              "type": "String"
            },
            "azureMgmtSubscriptionId": {
              "type": "String"
            },
            "azureVnetSubscriptionId": {
              "type": "String"
            }
          },
          "triggers": {
            "[format('{0}', variables('recommendationTriggerName'))]": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['ascassessment']['connectionId']"
                  }
                },
                "path": "/Microsoft.Security/Assessment/subscribe"
              }
            }
          },
          "actions": {
            "Compose_Recommendation_Details": {
              "type": "Compose",
              "inputs": {
                "recommendationName": "@{coalesce(triggerBody()?['properties']?['metadata']?['displayName'], '(名前なし)')}",
                "description": "@{coalesce(triggerBody()?['properties']?['metadata']?['description'], '説明はありません。')}",
                "resourceId": "@{coalesce(triggerBody()?['properties']?['resourceDetails']?['id'], '不明')}",
                "resourceName": "@{if(empty(triggerBody()?['properties']?['resourceDetails']?['id']), '不明', last(split(triggerBody()?['properties']?['resourceDetails']?['id'], '/')))}",
                "sourceSubscriptionId": "@{if(empty(triggerBody()?['properties']?['resourceDetails']?['id']), 'unknown', first(split(replace(replace(toLower(triggerBody()?['properties']?['resourceDetails']?['id']), '/subscriptions/', ''), 'subscriptions/', ''), '/')))}",
                "subscriptionName": "@{if(equals(if(empty(triggerBody()?['properties']?['resourceDetails']?['id']), 'unknown', first(split(replace(replace(toLower(triggerBody()?['properties']?['resourceDetails']?['id']), '/subscriptions/', ''), 'subscriptions/', ''), '/'))), toLower(parameters('azureMgmtSubscriptionId'))), 'ME-MngEnvMCAP780637-AzureMgmt', if(equals(if(empty(triggerBody()?['properties']?['resourceDetails']?['id']), 'unknown', first(split(replace(replace(toLower(triggerBody()?['properties']?['resourceDetails']?['id']), '/subscriptions/', ''), 'subscriptions/', ''), '/'))), toLower(parameters('azureVnetSubscriptionId'))), 'ME-MngEnvMCAP780637-AzureVnet', '不明'))}",
                "severity": "@{coalesce(triggerBody()?['properties']?['metadata']?['severity'], '不明')}",
                "severityColor": "@{if(equals(toLower(coalesce(triggerBody()?['properties']?['metadata']?['severity'], '')), 'high'), '#E01E5A', if(equals(toLower(coalesce(triggerBody()?['properties']?['metadata']?['severity'], '')), 'medium'), '#ECB22E', '#36C5F0'))}",
                "severityIndicator": "@{if(equals(toLower(coalesce(triggerBody()?['properties']?['metadata']?['severity'], '')), 'high'), '🔴', if(equals(toLower(coalesce(triggerBody()?['properties']?['metadata']?['severity'], '')), 'medium'), '🟡', '🔵'))}",
                "detectedAt": "@{coalesce(triggerBody()?['properties']?['status']?['statusChangeDate'], utcNow())}",
                "remediation": "@{coalesce(triggerBody()?['properties']?['metadata']?['remediationDescription'], 'Defender for Cloud で修復手順を確認してください。')}",
                "portalUrl": "@{if(empty(triggerBody()?['properties']?['links']?['azurePortalUri']), 'https://portal.azure.com/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/5', concat('https://', triggerBody()?['properties']?['links']?['azurePortalUri']))}"
              },
              "runAfter": {}
            },
            "Compose_Slack_Message": {
              "type": "Compose",
              "inputs": {
                "text": "@{concat('[Defender for Cloud] Recommendation: ', outputs('Compose_Recommendation_Details')?['recommendationName'])}",
                "attachments": [
                  {
                    "color": "@{outputs('Compose_Recommendation_Details')?['severityColor']}",
                    "blocks": [
                      {
                        "type": "header",
                        "text": {
                          "type": "plain_text",
                          "text": "Defender for Cloud セキュリティ推奨事項",
                          "emoji": true
                        }
                      },
                      {
                        "type": "section",
                        "text": {
                          "type": "mrkdwn",
                          "text": "@{concat('*', outputs('Compose_Recommendation_Details')?['recommendationName'], '*\n', outputs('Compose_Recommendation_Details')?['description'])}"
                        }
                      },
                      {
                        "type": "section",
                        "fields": [
                          {
                            "type": "mrkdwn",
                            "text": "@{concat('*重要度*\n', outputs('Compose_Recommendation_Details')?['severityIndicator'], ' ', outputs('Compose_Recommendation_Details')?['severity'])}"
                          },
                          {
                            "type": "mrkdwn",
                            "text": "@{concat('*状態変更時刻 (UTC)*\n', outputs('Compose_Recommendation_Details')?['detectedAt'])}"
                          },
                          {
                            "type": "mrkdwn",
                            "text": "@{concat('*対象リソース*\n', outputs('Compose_Recommendation_Details')?['resourceName'])}"
                          },
                          {
                            "type": "mrkdwn",
                            "text": "@{concat('*サブスクリプション名*\n', outputs('Compose_Recommendation_Details')?['subscriptionName'])}"
                          }
                        ]
                      },
                      {
                        "type": "section",
                        "text": {
                          "type": "mrkdwn",
                          "text": "@{concat('*推奨される対応*\n', outputs('Compose_Recommendation_Details')?['remediation'])}"
                        }
                      },
                      {
                        "type": "actions",
                        "elements": [
                          {
                            "type": "button",
                            "text": {
                              "type": "plain_text",
                              "text": "Defender for Cloud で確認"
                            },
                            "style": "primary",
                            "url": "@{outputs('Compose_Recommendation_Details')?['portalUrl']}"
                          }
                        ]
                      },
                      {
                        "type": "context",
                        "elements": [
                          {
                            "type": "mrkdwn",
                            "text": "Microsoft Defender for Cloud | CSPM"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "runAfter": {
                "Compose_Recommendation_Details": [
                  "Succeeded"
                ]
              }
            },
            "Route_Recommendation_By_Subscription": {
              "type": "Switch",
              "expression": "@if(equals(outputs('Compose_Recommendation_Details')?['sourceSubscriptionId'], toLower(parameters('azureMgmtSubscriptionId'))), 'AzureMgmt', if(equals(outputs('Compose_Recommendation_Details')?['sourceSubscriptionId'], toLower(parameters('azureVnetSubscriptionId'))), 'AzureVnet', 'Unknown'))",
              "cases": {
                "AzureMgmt": {
                  "case": "AzureMgmt",
                  "actions": {
                    "Post_Recommendation_to_AzureMgmt_Slack": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "@parameters('azureMgmtSlackWebhookUrl')",
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": "@outputs('Compose_Slack_Message')"
                      }
                    }
                  }
                },
                "AzureVnet": {
                  "case": "AzureVnet",
                  "actions": {
                    "Post_Recommendation_to_AzureVnet_Slack": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "@parameters('azureVnetSlackWebhookUrl')",
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": "@outputs('Compose_Slack_Message')"
                      }
                    }
                  }
                }
              },
              "default": {
                "actions": {}
              },
              "runAfter": {
                "Compose_Slack_Message": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "ascassessment": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('recommendationConnectionName'))]",
                "connectionName": "[variables('recommendationConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'ascassessment')]"
              }
            }
          },
          "azureMgmtSlackWebhookUrl": {
            "value": "[parameters('azureMgmtSlackWebhookUrl')]"
          },
          "azureVnetSlackWebhookUrl": {
            "value": "[parameters('azureVnetSlackWebhookUrl')]"
          },
          "azureMgmtSubscriptionId": {
            "value": "[parameters('azureMgmtSubscriptionId')]"
          },
          "azureVnetSubscriptionId": {
            "value": "[parameters('azureVnetSubscriptionId')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('recommendationConnectionName'))]"
      ]
    }
  ],
  "outputs": {
    "recommendationLogicAppName": {
      "type": "string",
      "value": "[variables('recommendationWorkflowName')]"
    }
  }
}
