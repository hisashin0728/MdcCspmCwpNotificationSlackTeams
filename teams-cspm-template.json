{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Defender for Cloud CSPM recommendations to Microsoft Teams",
    "description": "Deploys a Defender for Cloud recommendation workflow automation and a Logic App that posts Adaptive Cards to a Teams channel."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Deployment region for the Logic Apps, API connections, and workflow automations."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "mdc-teams",
      "minLength": 3,
      "maxLength": 40,
      "metadata": {
        "description": "Prefix used for deployed resource names."
      }
    },
    "teamId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Teams team ID (group ID) that contains the target channel."
      }
    },
    "channelId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Teams channel ID that receives Adaptive Cards."
      }
    },
    "recommendationIds": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Recommendation assessment IDs to notify. Leave empty to notify all unhealthy recommendations."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "security-notification",
        "managedBy": "arm-template"
      },
      "metadata": {
        "description": "Tags applied to deployed resources."
      }
    }
  },
  "variables": {
    "recommendationWorkflowName": "[format('{0}-cspm-recommendation', parameters('namePrefix'))]",
    "recommendationConnectionName": "[format('{0}-ascassessment', parameters('namePrefix'))]",
    "teamsConnectionName": "[format('{0}-teams', parameters('namePrefix'))]",
    "recommendationAutomationName": "[format('{0}-recommendation-automation', parameters('namePrefix'))]",
    "recommendationTriggerName": "When_a_Microsoft_Defender_for_Cloud_recommendation_is_created_or_triggered"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('recommendationConnectionName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[variables('recommendationConnectionName')]",
        "customParameterValues": {},
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'ascassessment')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('teamsConnectionName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[variables('teamsConnectionName')]",
        "customParameterValues": {},
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('recommendationWorkflowName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject('LogicAppsCategory', 'security'))]",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "teamId": {
              "type": "String"
            },
            "channelId": {
              "type": "String"
            },
            "subscriptionName": {
              "type": "String"
            }
          },
          "triggers": {
            "[format('{0}', variables('recommendationTriggerName'))]": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['ascassessment']['connectionId']"
                  }
                },
                "path": "/Microsoft.Security/Assessment/subscribe"
              }
            }
          },
          "actions": {
            "Compose_Recommendation_Details": {
              "type": "Compose",
              "inputs": {
                "recommendationName": "@{coalesce(triggerBody()?['properties']?['metadata']?['displayName'], '(名前なし)')}",
                "description": "@{coalesce(triggerBody()?['properties']?['metadata']?['description'], '説明はありません。')}",
                "resourceId": "@{coalesce(triggerBody()?['properties']?['resourceDetails']?['id'], '不明')}",
                "resourceName": "@{if(empty(triggerBody()?['properties']?['resourceDetails']?['id']), '不明', last(split(triggerBody()?['properties']?['resourceDetails']?['id'], '/')))}",
                "subscriptionName": "@parameters('subscriptionName')",
                "severity": "@{coalesce(triggerBody()?['properties']?['metadata']?['severity'], '不明')}",
                "severityIndicator": "@{if(equals(toLower(coalesce(triggerBody()?['properties']?['metadata']?['severity'], '')), 'high'), '🔴', if(equals(toLower(coalesce(triggerBody()?['properties']?['metadata']?['severity'], '')), 'medium'), '🟡', '🔵'))}",
                "detectedAt": "@{coalesce(triggerBody()?['properties']?['status']?['statusChangeDate'], utcNow())}",
                "remediation": "@{coalesce(triggerBody()?['properties']?['metadata']?['remediationDescription'], 'Defender for Cloud で修復手順を確認してください。')}",
                "portalUrl": "@{if(empty(triggerBody()?['properties']?['links']?['azurePortalUri']), 'https://portal.azure.com/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/5', concat('https://', triggerBody()?['properties']?['links']?['azurePortalUri']))}"
              },
              "runAfter": {}
            },
            "Compose_Adaptive_Card": {
              "type": "Compose",
              "inputs": {
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "msteams": {
                  "width": "Full"
                },
                "body": [
                  {
                    "type": "TextBlock",
                    "text": "Defender for Cloud セキュリティ推奨事項",
                    "weight": "Bolder",
                    "size": "Medium",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "text": "@{outputs('Compose_Recommendation_Details')?['recommendationName']}",
                    "weight": "Bolder",
                    "size": "Large",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "text": "@{outputs('Compose_Recommendation_Details')?['description']}",
                    "wrap": true
                  },
                  {
                    "type": "FactSet",
                    "facts": [
                      {
                        "title": "重要度",
                        "value": "@{concat(outputs('Compose_Recommendation_Details')?['severityIndicator'], ' ', outputs('Compose_Recommendation_Details')?['severity'])}"
                      },
                      {
                        "title": "状態変更時刻 (UTC)",
                        "value": "@{outputs('Compose_Recommendation_Details')?['detectedAt']}"
                      },
                      {
                        "title": "対象リソース",
                        "value": "@{outputs('Compose_Recommendation_Details')?['resourceName']}"
                      },
                      {
                        "title": "サブスクリプション名",
                        "value": "@{outputs('Compose_Recommendation_Details')?['subscriptionName']}"
                      }
                    ]
                  },
                  {
                    "type": "TextBlock",
                    "text": "推奨される対応",
                    "weight": "Bolder",
                    "spacing": "Medium",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "text": "@{outputs('Compose_Recommendation_Details')?['remediation']}",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "text": "Microsoft Defender for Cloud | CSPM",
                    "isSubtle": true,
                    "spacing": "Medium",
                    "wrap": true
                  }
                ],
                "actions": [
                  {
                    "type": "Action.OpenUrl",
                    "title": "Defender for Cloud で確認",
                    "url": "@{outputs('Compose_Recommendation_Details')?['portalUrl']}"
                  }
                ]
              },
              "runAfter": {
                "Compose_Recommendation_Details": [
                  "Succeeded"
                ]
              }
            },
            "Post_Recommendation_to_Teams": {
              "type": "ApiConnection",
              "inputs": {
                "body": {
                  "messageBody": "@{string(outputs('Compose_Adaptive_Card'))}",
                  "recipient": {
                    "groupId": "@parameters('teamId')",
                    "channelId": "@parameters('channelId')"
                  }
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['teams']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v1.0/teams/conversation/adaptivecard/poster/@{encodeURIComponent('User')}/location/@{encodeURIComponent('Channel')}"
              },
              "runAfter": {
                "Compose_Adaptive_Card": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "ascassessment": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('recommendationConnectionName'))]",
                "connectionName": "[variables('recommendationConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'ascassessment')]"
              },
              "teams": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('teamsConnectionName'))]",
                "connectionName": "[variables('teamsConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
              }
            }
          },
          "teamId": {
            "value": "[parameters('teamId')]"
          },
          "channelId": {
            "value": "[parameters('channelId')]"
          },
          "subscriptionName": {
            "value": "[subscription().displayName]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('recommendationConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('teamsConnectionName'))]"
      ]
    },
    {
      "type": "Microsoft.Security/automations",
      "apiVersion": "2023-12-01-preview",
      "name": "[variables('recommendationAutomationName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "Send unhealthy Defender for Cloud posture recommendations to Microsoft Teams.",
        "isEnabled": true,
        "scopes": [
          {
            "description": "[format('All resources in subscription {0}', subscription().subscriptionId)]",
            "scopePath": "[subscription().id]"
          }
        ],
        "sources": [
          {
            "copy": [
              {
                "name": "ruleSets",
                "count": "[length(if(empty(parameters('recommendationIds')), createArray(''), parameters('recommendationIds')))]",
                "input": {
                  "rules": "[concat(createArray(createObject('propertyJPath', 'properties.status.code', 'propertyType', 'String', 'expectedValue', 'unhealthy', 'operator', 'Equals')), if(empty(if(empty(parameters('recommendationIds')), createArray(''), parameters('recommendationIds'))[copyIndex('ruleSets')]), createArray(), createArray(createObject('propertyJPath', 'name', 'propertyType', 'String', 'expectedValue', if(empty(parameters('recommendationIds')), createArray(''), parameters('recommendationIds'))[copyIndex('ruleSets')], 'operator', 'Contains'))))]"
                }
              }
            ],
            "eventSource": "Assessments"
          }
        ],
        "actions": [
          {
            "actionType": "LogicApp",
            "logicAppResourceId": "[resourceId('Microsoft.Logic/workflows', variables('recommendationWorkflowName'))]",
            "uri": "[listCallbackUrl(format('{0}/triggers/{1}', resourceId('Microsoft.Logic/workflows', variables('recommendationWorkflowName')), variables('recommendationTriggerName')), '2016-06-01').value]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', variables('recommendationWorkflowName'))]"
      ]
    }
  ],
  "outputs": {
    "recommendationLogicAppName": {
      "type": "string",
      "value": "[variables('recommendationWorkflowName')]"
    },
    "teamsConnectionName": {
      "type": "string",
      "value": "[variables('teamsConnectionName')]"
    },
    "recommendationAutomationResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Security/automations', variables('recommendationAutomationName'))]"
    }
  }
}
